@using MauiBlazorCharts.Models

<div style="padding: 20px; background: white; font-family: sans-serif;">
    <h3 style="margin-top: 0; color: #333;">@ChartData.Title</h3>
    <p style="color: #666; font-size: 14px;">@ChartData.Description</p>

    <!-- Prikaz istorijskih tačaka u obliku liste/trenda -->
    <div
        style="margin: 15px 0; max-height: 140px; overflow-y: auto; background: #f9f9f9; padding: 10px; border-radius: 6px;">
        <table style="width: 100%; font-size: 13px; text-align: left; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 1px solid #ddd; color: #777;">
                    <th>Vreme</th>
                    <th>Vrednost</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var point in ChartData.HistoricalData.TakeLast(4))
                {
                    <tr style="border-bottom: 1px solid #eee;">
                        <td style="padding: 5px 0; color: #555;">@point.Label</td>
                        <td style="font-weight: bold; color: #e91e63;">@point.Value.ToString("F0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div style="display: flex; gap: 10px; margin-top: 15px;">
        <button @onclick="() => OnValueIncreased.InvokeAsync(ChartData)"
                style="padding: 5px 15px; background: #4caf50; color: white; border: none; border-radius: 4px; cursor: pointer;">+</button>
        <button @onclick="() => OnValueDecreased.InvokeAsync(ChartData)"
                style="padding: 5px 15px; background: #f44336; color: white; border: none; border-radius: 4px; cursor: pointer;">-</button>
        <button @onclick="() => OnChartReset.InvokeAsync(ChartData)"
                style="padding: 5px 15px; background: #9e9e9e; color: white; border: none; border-radius: 4px; cursor: pointer;">Reset</button>
    </div>
</div>

@code {
    [Parameter] public ChartItem ChartData { get; set; } = null!;
    [Parameter] public EventCallback<ChartItem> OnValueIncreased { get; set; }
    [Parameter] public EventCallback<ChartItem> OnValueDecreased { get; set; }
    [Parameter] public EventCallback<ChartItem> OnChartReset { get; set; }
}
