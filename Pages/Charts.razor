@page "/charts"
@using MauiBlazorCharts.Models
@using MauiBlazorCharts.ViewModels
@using MauiBlazorCharts.Pages
@using MauiBlazorCharts.Services
@using CommunityToolkit.Mvvm.Messaging
@implements IDisposable
@inject MainViewModel ViewModel

<PageTitle>MAUI Blazor Charts - Kartice</PageTitle>

<div style="padding: 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <div>
            <h2 style="margin-bottom: 4px;">Sve Kartice sa Graficima</h2>
            <p style="color: #666; font-size: 13px; margin: 0;">Podaci se u realnom vremenu čitaju i upisuju u SQLite bazu podataka.</p>
        </div>
        <button @onclick="RefreshAll"
                style="padding: 10px 20px; background-color: #2196f3; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">
            🔄 Osvežite sve
        </button>
    </div>

    @if (ViewModel.IsLoading)
    {
        <div style="text-align: center; padding: 40px;">
            <p style="font-size: 18px; color: #999;">Učitavanje podataka iz SQLite baze...</p>
        </div>
    }
    else if (!ViewModel.Charts.Any())
    {
        <div style="background-color: #ffebee; padding: 20px; border-radius: 4px; border-left: 4px solid #f44336;">
            <h4 style="color: #c62828;">Nema dostupnih kartica</h4>
            <p>Pokušajte da se vratite na početnu stranicu i ponovo inicijalizujete aplikaciju.</p>
        </div>
    }
    else
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 20px;">
            @foreach (var chart in ViewModel.Charts)
            {
                <div
                    style="border: 1px solid #ddd; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 6px rgba(0,0,0,0.08); background: white;">
                    @switch (chart.Type)
                    {
                        case ChartType.Bar:
                            <BarChartCard ChartData="chart" OnValueIncreased="IncreaseValue" OnValueDecreased="DecreaseValue"
                                          OnChartReset="ResetChart" />
                            break;

                        case ChartType.Pie:
                            <PieChartCard ChartData="chart" OnValueIncreased="IncreaseValue" OnValueDecreased="DecreaseValue"
                                          OnChartReset="ResetChart" />
                            break;

                        case ChartType.RoundGauge:
                            <RoundGaugeCard ChartData="chart" OnValueIncreased="IncreaseValue" OnValueDecreased="DecreaseValue"
                                            OnChartReset="ResetChart" />
                            break;

                        case ChartType.HistoricalPlot:
                            <HistoricalPlotCard ChartData="chart" OnValueIncreased="IncreaseValue" OnValueDecreased="DecreaseValue"
                                                OnChartReset="ResetChart" />
                            break;
                    }
                </div>
            }
        </div>

        <div style="background-color: #f5f5f5; padding: 15px; border-radius: 4px; margin-top: 20px; border-left: 4px solid #2196f3;">
            <h4>Status SQLite sinhronizacije:</h4>
            <p style="margin: 0; font-size: 14px; color: #333;">@ViewModel.StatusMessage</p>
        </div>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        WeakReferenceMessenger.Default.Register<ChartUpdatedMessage>(this, (_, _) =>
        {
            _ = InvokeAsync(StateHasChanged);
        });

        WeakReferenceMessenger.Default.Register<AllChartsRefreshedMessage>(this, (_, _) =>
        {
            _ = InvokeAsync(StateHasChanged);
        });

        WeakReferenceMessenger.Default.Register<RefreshAllChartsMessage>(this, (_, _) =>
        {
            _ = InvokeAsync(StateHasChanged);
        });

        if (!ViewModel.Charts.Any())
        {
            await ViewModel.InitializeCommand.ExecuteAsync(null);
        }
    }

    public void Dispose()
    {
        WeakReferenceMessenger.Default.UnregisterAll(this);
    }

    private void IncreaseValue(ChartItem? chart)
    {
        ViewModel.IncreaseValueCommand.Execute(chart);
    }

    private void DecreaseValue(ChartItem? chart)
    {
        ViewModel.DecreaseValueCommand.Execute(chart);
    }

    private void ResetChart(ChartItem? chart)
    {
        ViewModel.ResetChartCommand.Execute(chart);
    }

    private void RefreshAll()
    {
        ViewModel.RefreshAllChartsCommand.Execute(null);
    }
}
