@using MauiBlazorCharts.Models

<div style="padding: 20px; background: white; font-family: sans-serif; height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
    <div>
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 5px;">
            <h3 style="margin: 0; color: #333;">@ChartData.Title</h3>
            <span style="background: #e3f2fd; color: #1976d2; font-size: 11px; padding: 3px 8px; border-radius: 12px; font-weight: bold;">SQLite</span>
        </div>
        <p style="color: #666; font-size: 13px; margin-bottom: 15px;">@ChartData.Description</p>

        @{
            var gaugeColor = ChartData.CurrentValue >= 80 ? "#4caf50" : (ChartData.CurrentValue >= 50 ? "#ff9800" : "#f44336");
            var pctString = ChartData.CurrentValue.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
        }

        <div style="display: flex; justify-content: center; align-items: center; margin: 15px 0;">
            <div @key="ChartData.CurrentValue" class="chart-value-update"
                 style="width: 140px; height: 140px; border-radius: 50%; background: conic-gradient(@gaugeColor 0% @(pctString)%, #e0e0e0 @(pctString)% 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0,0,0,0.08);">
                <div style="width: 105px; height: 105px; background: white; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: inset 0 2px 4px rgba(0,0,0,0.08);">
                    <span style="font-size: 22px; font-weight: bold; color: @gaugeColor;">
                        @ChartData.CurrentValue.ToString("F1")%
                    </span>
                    <span style="font-size: 10px; color: #888; text-transform: uppercase;">
                        @(ChartData.CurrentValue >= 80 ? "Excellent" : (ChartData.CurrentValue >= 50 ? "Moderate" : "Critical"))
                    </span>
                </div>
            </div>
        </div>

        <div style="display: flex; justify-content: space-between; padding: 8px 12px; background: #f8f9fa; border-radius: 6px; font-size: 12px; color: #666;">
            <span>Min: @ChartData.MinValue%</span>
            <span>Target: &gt; 85%</span>
            <span>Max: @ChartData.MaxValue%</span>
        </div>
    </div>

    <!-- Value control buttons -->
    <div style="display: flex; gap: 8px; margin-top: 15px;">
        <button @onclick="() => OnValueIncreased.InvokeAsync(ChartData)"
                style="flex: 1; padding: 8px 12px; background: #4caf50; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 14px;">+ Increase</button>
        <button @onclick="() => OnValueDecreased.InvokeAsync(ChartData)"
                style="flex: 1; padding: 8px 12px; background: #f44336; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 14px;">- Decrease</button>
        <button @onclick="() => OnChartReset.InvokeAsync(ChartData)"
                style="padding: 8px 15px; background: #757575; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 13px;">Reset</button>
    </div>
</div>

@code {
    [Parameter] public ChartItem ChartData { get; set; } = null!;
    [Parameter] public EventCallback<ChartItem> OnValueIncreased { get; set; }
    [Parameter] public EventCallback<ChartItem> OnValueDecreased { get; set; }
    [Parameter] public EventCallback<ChartItem> OnChartReset { get; set; }
}
