@using MauiBlazorCharts.Models

<div style="padding: 20px; background: white; font-family: sans-serif; height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
    <div>
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 5px;">
            <h3 style="margin: 0; color: #333;">@ChartData.Title</h3>
            <span style="background: #e3f2fd; color: #1976d2; font-size: 11px; padding: 3px 8px; border-radius: 12px; font-weight: bold;">SQLite</span>
        </div>
        <p style="color: #666; font-size: 13px; margin-bottom: 15px;">@ChartData.Description</p>

        <!-- Bar display based on SQLite data -->
        <div style="display: flex; align-items: flex-end; height: 160px; gap: 8px; margin: 15px 0; border-bottom: 2px solid #e0e0e0; padding-bottom: 8px;">
            @{
                var displayPoints = ChartData.HistoricalData.TakeLast(6).ToList();
                var barColors = new[] { "#8bc34a", "#ff9800", "#00bcd4", "#9c27b0", "#e91e63", "#2196f3" };
            }
            @for (int i = 0; i < displayPoints.Count; i++)
            {
                var point = displayPoints[i];
                var color = barColors[i % barColors.Length];
                var heightPercent = ChartData.MaxValue > 0 
                    ? Math.Max(10, Math.Min(100, (point.Value / ChartData.MaxValue) * 100)) 
                    : 10;
                var isLatest = (i == displayPoints.Count - 1);

                <div style="flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; justify-content: flex-end;">
                    <div style="font-size: 10px; color: #666; margin-bottom: 4px; font-weight: @(isLatest ? "bold" : "normal");">
                        @point.Value.ToString("N0")
                    </div>
                    <div @key="point.Timestamp" class="chart-value-update"
                         style="width: 100%; background: @color; height: @(heightPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%; border-radius: 4px 4px 0 0; transition: height 0.4s ease; @(isLatest ? "box-shadow: 0 0 8px " + color + ";" : "")">
                    </div>
                    <div style="font-size: 11px; color: #333; margin-top: 6px; font-weight: @(isLatest ? "bold" : "normal");">
                        @point.Label
                    </div>
                </div>
            }
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px; padding: 8px 12px; background: #f8f9fa; border-radius: 6px; font-size: 13px;">
            <span style="color: #666;">Current value:</span>
            <strong style="color: #2196f3; font-size: 16px;">@ChartData.CurrentValue.ToString("N0")</strong>
        </div>
    </div>

    <div style="display: flex; gap: 8px; margin-top: 15px;">
        <button @onclick="() => OnValueIncreased.InvokeAsync(ChartData)"
                style="flex: 1; padding: 8px 12px; background: #4caf50; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 14px;">+ Increase</button>
        <button @onclick="() => OnValueDecreased.InvokeAsync(ChartData)"
                style="flex: 1; padding: 8px 12px; background: #f44336; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 14px;">- Decrease</button>
        <button @onclick="() => OnChartReset.InvokeAsync(ChartData)"
                style="padding: 8px 15px; background: #757575; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 13px;">Reset</button>
    </div>
</div>

@code {
    [Parameter] public ChartItem ChartData { get; set; } = null!;
    [Parameter] public EventCallback<ChartItem> OnValueIncreased { get; set; }
    [Parameter] public EventCallback<ChartItem> OnValueDecreased { get; set; }
    [Parameter] public EventCallback<ChartItem> OnChartReset { get; set; }
}
