@using MauiBlazorCharts.Models

<div style="padding: 20px; background: white; font-family: sans-serif; height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
    <div>
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 5px;">
            <h3 style="margin: 0; color: #333;">@ChartData.Title</h3>
            <span style="background: #e3f2fd; color: #1976d2; font-size: 11px; padding: 3px 8px; border-radius: 12px; font-weight: bold;">SQLite</span>
        </div>
        <p style="color: #666; font-size: 13px; margin-bottom: 12px;">@ChartData.Description</p>

        <!-- SVG line chart through SQLite data -->
        @{
            var points = ChartData.HistoricalData.TakeLast(6).ToList();
            var svgWidth = 320;
            var svgHeight = 70;
            var maxVal = Math.Max(1, ChartData.MaxValue);
            var coordinates = new List<(double X, double Y, DataPoint Point)>();

            if (points.Count > 1)
            {
                for (int i = 0; i < points.Count; i++)
                {
                    double x = 20 + (i * ((svgWidth - 40.0) / (points.Count - 1)));
                    double normY = Math.Clamp(points[i].Value / maxVal, 0, 1);
                    double y = (svgHeight - 15) - (normY * (svgHeight - 25));
                    coordinates.Add((x, y, points[i]));
                }
            }
            var pathData = coordinates.Count > 0 
                ? "M " + string.Join(" L ", coordinates.Select(c => $"{c.X.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)},{c.Y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}"))
                : "";
        }

        @if (coordinates.Count > 1)
        {
            <div style="background: #fafafa; border: 1px solid #eee; border-radius: 6px; padding: 6px; margin-bottom: 10px;">
                <svg viewBox="0 0 @svgWidth @svgHeight" style="width: 100%; height: 70px; display: block;">
                    <path d="@pathData" fill="none" stroke="#667eea" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    @foreach (var coord in coordinates)
                    {
                        <circle cx="@coord.X.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" 
                                cy="@coord.Y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" 
                                r="4" fill="#764ba2" stroke="#fff" stroke-width="1.5" />
                    }
                </svg>
            </div>
        }

        <!-- Historical points displayed as a table from SQLite -->
        <div style="max-height: 95px; overflow-y: auto; background: #f9f9f9; padding: 6px 10px; border-radius: 6px; border: 1px solid #eee;">
            <table style="width: 100%; font-size: 12px; text-align: left; border-collapse: collapse; margin-bottom: 0;">
                <thead>
                    <tr style="border-bottom: 1px solid #ddd; color: #777;">
                        <th style="padding: 4px 0;">Time</th>
                        <th style="padding: 4px 0;">Value</th>
                        <th style="padding: 4px 0; text-align: right;">Recorded</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var point in ChartData.HistoricalData.TakeLast(5).Reverse())
                    {
                        <tr @key="point.Timestamp" style="border-bottom: 1px solid #f0f0f0;">
                            <td style="padding: 3px 0; color: #555;">@point.Label</td>
                            <td style="padding: 3px 0; font-weight: bold; color: #667eea;">@point.Value.ToString("N0")</td>
                            <td style="padding: 3px 0; color: #999; font-size: 11px; text-align: right;">@point.Timestamp.ToString("HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div style="display: flex; gap: 8px; margin-top: 15px;">
        <button @onclick="() => OnValueIncreased.InvokeAsync(ChartData)"
                style="flex: 1; padding: 8px 12px; background: #4caf50; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 14px;">+ Increase</button>
        <button @onclick="() => OnValueDecreased.InvokeAsync(ChartData)"
                style="flex: 1; padding: 8px 12px; background: #f44336; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 14px;">- Decrease</button>
        <button @onclick="() => OnChartReset.InvokeAsync(ChartData)"
                style="padding: 8px 15px; background: #757575; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 13px;">Reset</button>
    </div>
</div>

@code {
    [Parameter] public ChartItem ChartData { get; set; } = null!;
    [Parameter] public EventCallback<ChartItem> OnValueIncreased { get; set; }
    [Parameter] public EventCallback<ChartItem> OnValueDecreased { get; set; }
    [Parameter] public EventCallback<ChartItem> OnChartReset { get; set; }
}
